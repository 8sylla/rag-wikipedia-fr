        </mxCell>
        <mxCell id="root" value="&lt;b&gt;texte ≤ 110 tokens ?&lt;/b&gt;&lt;br&gt;non → couper sur le 1er séparateur présent" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#FFFFFF;strokeColor=#EB6834;fontColor=#0B0B0B;" vertex="1" parent="laneB">
