        <mxCell id="e_cB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#52514E;strokeWidth=1.5;exitX=0.75;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="clean" target="laneB">
          <mxGeometry relative="1" as="geometry" />
