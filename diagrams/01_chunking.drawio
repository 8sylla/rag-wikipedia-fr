          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ Méthode 1 : fenêtre fixe ============ -->
        <mxCell id="laneA" value="MÉTHODE 1 : fenêtre fixe, T = 400 caractères, chevauchement O = 50" style="swimlane;html=1;startSize=32;fillColor=#E3EEFB;swimlaneFillColor=#FCFCFB;strokeColor=#2A78D6;fontColor=#0B0B0B;fontStyle=1;fontSize=13;align=left;spacingLeft=12;rounded=1;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="20" y="130" width="760" height="600" as="geometry" />
        </mxCell>
        <mxCell id="barre" value="texte nettoyé : « Paul Jules Antoine Meillet, né le à Moulins (Allier) et mort le à Châteaumeillant (Cher), est le principal … »" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;fillColor=#F0EFEC;strokeColor=#898781;fontColor=#52514E;" vertex="1" parent="laneA">
          <mxGeometry x="20" y="55" width="720" height="34" as="geometry" />
        </mxCell>
        <!-- échelle : 1 caractère = 0,9 px ; pas = 350 car. = 315 px ; fenêtre = 400 car. = 360 px -->
        <mxCell id="w0" value="chunk 0 : caractères [0, 400)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#CDE2FB;strokeColor=#2A78D6;fontColor=#0B0B0B;" vertex="1" parent="laneA">
          <mxGeometry x="20" y="110" width="360" height="34" as="geometry" />
