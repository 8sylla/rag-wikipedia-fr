<mxfile host="app.diagrams.net" version="24.7.17">
  <diagram id="chunking" name="Partie 1 - chunking">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1060" background="#FCFCFB" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ Entrée et nettoyage commun ============ -->
        <mxCell id="in" value="&lt;b&gt;df['body']&lt;/b&gt;&lt;br&gt;1 000 articles bruts" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;fillColor=#F0EFEC;strokeColor=#898781;fontColor=#0B0B0B;" vertex="1" parent="1">
          <mxGeometry x="360" y="20" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="clean" value="&lt;b&gt;nettoyer()&lt;/b&gt;, appliqué aux deux méthodes&lt;br&gt;coupe à la 1re section de fin vide · retire « ( , ) » et la catégorie Homonymie · espaces doubles → simples&lt;br&gt;&lt;i&gt;7,3 % du texte retiré, 757 articles raccourcis : le même texte entre dans chaque méthode&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=12;spacing=8;fillColor=#F0EFEC;strokeColor=#898781;fontColor=#0B0B0B;" vertex="1" parent="1">
