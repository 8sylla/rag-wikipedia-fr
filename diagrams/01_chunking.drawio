          <mxGeometry x="650" y="160" width="45" height="84" as="geometry" />
        </mxCell>
        <mxCell id="ov_lbl" value="zone jaune : chevauchement O = 50 car., présent dans deux chunks" style="text;html=1;fontSize=11;fontColor=#52514E;align=left;verticalAlign=middle;" vertex="1" parent="laneA">
          <mxGeometry x="20" y="232" width="420" height="26" as="geometry" />
        </mxCell>
        <mxCell id="pas" value="pas = T − O = 350 caractères" style="text;html=1;fontSize=11;fontColor=#52514E;align=left;" vertex="1" parent="laneA">
          <mxGeometry x="20" y="160" width="250" height="30" as="geometry" />
        </mxCell>
        <mxCell id="formA" value="&lt;b&gt;Formules&lt;/b&gt;&lt;br&gt;nombre de chunks = 1 + ⌈(L − T) / (T − O)⌉&lt;br&gt;redondance ≈ T / (T − O) = 400 / 350 ≈ 1,14 (mesurée : 1,13)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=8;fillColor=#FCFCFB;strokeColor=#2A78D6;dashed=1;fontColor=#0B0B0B;align=left;" vertex="1" parent="laneA">
          <mxGeometry x="20" y="265" width="720" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cutA" value="&lt;b&gt;Ce que donne la coupe à l'aveugle (chunks réels de « Antoine Meillet »)&lt;/b&gt;&lt;br&gt;… à la tête de la &lt;b&gt;c&lt;/b&gt; ┃ &lt;b&gt;da&lt;/b&gt; au linguiste Auguste Carrière à la tête de la chaire …&lt;br&gt;… parmi lesquels Émile Benveniste, Marcel Cohen, Georges ┃ lesquels Émile Benveniste …" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=8;fillColor=#FCFCFB;strokeColor=#898781;fontColor=#0B0B0B;align=left;" vertex="1" parent="laneA">
          <mxGeometry x="20" y="365" width="720" height="90" as="geometry" />
        </mxCell>
        <mxCell id="bilanA" value="&lt;b&gt;+&lt;/b&gt; simple, rapide, taille connue d'avance&lt;br&gt;&lt;b&gt;−&lt;/b&gt; 82 % des chunks coupent un mot ; 14 % commencent proprement ; 7 % restent tronqués par l'encodeur (la taille en caractères n'est qu'une approximation des tokens)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=8;fillColor=#E3EEFB;strokeColor=#2A78D6;fontColor=#0B0B0B;align=left;" vertex="1" parent="laneA">
          <mxGeometry x="20" y="475" width="720" height="100" as="geometry" />
        </mxCell>

        <!-- ============ Méthode 2 : récursif ============ -->
        <mxCell id="laneB" value="MÉTHODE 2 : récursif, au plus 110 tokens MiniLM, chevauchement 15 tokens" style="swimlane;html=1;startSize=32;fillColor=#FCE6DC;swimlaneFillColor=#FCFCFB;strokeColor=#EB6834;fontColor=#0B0B0B;fontStyle=1;fontSize=13;align=left;spacingLeft=12;rounded=1;arcSize=3;" vertex="1" parent="1">
